CSMARKETAPI_API_KEY=your_csmarketapi_key_here
CS2CAP_API_KEY=your_cs2cap_key_here
DATABASE_URL=DATABASE_URL

# Steam sign-in. Without STEAM_API_KEY the site still runs, just with auth disabled.
# Key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_web_api_key_here

# Where the browser reaches this site - Steam redirects back here after sign-in, so it must
# match exactly. http://localhost:3001 when developing, http://<pi-ip>:3001 on the Pi.
BASE_URL=http://localhost:3001

# Signs the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=change_me_to_a_long_random_string
